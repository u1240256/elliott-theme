{%- comment -%}
  Section with a heading, a row of tabs, and under each tab a row of image cards with an underlined label.
  Every "Card" block belongs to the closest "Tab" block above it.
{%- endcomment -%}
{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}
{%- assign tab_count = section.blocks | where: 'type', 'tab' | size -%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} section-spacing {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
  <div class="container container--lg">
    <tabbed-collection-cards class="tabbed-cards" style="--tabbed-cards-columns: {{ section.settings.cards_per_row }}">
      {%- if section.settings.title != blank -%}
        <h2 class="tabbed-cards__title {{ section.settings.heading_style }} text-center">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if tab_count > 1 -%}
        <div class="tabbed-cards__tabs" role="tablist">
          {%- assign tab_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              <button
                type="button"
                role="tab"
                id="{{ section.id }}-tab-{{ tab_index }}"
                class="tabbed-cards__tab"
                aria-controls="{{ section.id }}-panel-{{ tab_index }}"
                aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
                {% if tab_index > 0 %}tabindex="-1"{% endif %}
                {{ block.shopify_attributes }}
              >
                {{- block.settings.title -}}
              </button>
              {%- assign tab_index = tab_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- liquid
        assign last_panel_index = tab_count | minus: 1
        if last_panel_index < 0
          assign last_panel_index = 0
        endif
      -%}

      {%- for panel_index in (0..last_panel_index) -%}
        <div
          id="{{ section.id }}-panel-{{ panel_index }}"
          class="tabbed-cards__panel"
          {% if tab_count > 1 %}role="tabpanel" aria-labelledby="{{ section.id }}-tab-{{ panel_index }}"{% endif %}
          {% if panel_index > 0 %}hidden{% endif %}
        >
          {%- assign block_tab_index = 0 -%}
          {%- assign seen_tab = false -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              {%- if seen_tab -%}
                {%- assign block_tab_index = block_tab_index | plus: 1 -%}
              {%- endif -%}
              {%- assign seen_tab = true -%}
              {%- continue -%}
            {%- endif -%}

            {%- if block_tab_index != panel_index -%}
              {%- continue -%}
            {%- endif -%}

            {%- assign card_link = block.settings.link | default: block.settings.collection.url -%}
            {%- assign card_label = block.settings.label | default: block.settings.collection.title -%}
            {%- assign card_image = block.settings.image | default: block.settings.collection.featured_image -%}
            {%- assign stock_handles = 'baby,kids,accessories,swaddles,zipper-footies,rompers,twirl-dresses,top-bottoms' | split: ',' -%}

            <a href="{{ card_link | default: '#' }}" class="tabbed-cards__card group" {{ block.shopify_attributes }}>
              <div class="tabbed-cards__media">
                {%- if card_image != blank -%}
                  {{- card_image | image_url: width: 900 | image_tag: sizes: '(max-width: 699px) 70vw, 25vw', widths: '300,400,500,600,700,800,900', class: 'zoom-image group-hover:zoom', loading: 'lazy', alt: '' -}}
                {%- elsif stock_handles contains block.settings.collection.handle -%}
                  {%- assign stock_name = 'stock-card-' | append: block.settings.collection.handle -%}
                  {%- render 'stock-image', name: stock_name, class: 'zoom-image group-hover:zoom' -%}
                {%- else -%}
                  {{- 'collection-1' | placeholder_svg_tag: 'placeholder' -}}
                {%- endif -%}
              </div>

              {%- if card_label != blank -%}
                <span class="tabbed-cards__label">{{ card_label }}</span>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </tabbed-collection-cards>
  </div>
</div>

{% stylesheet %}
  .tabbed-cards__title {
    margin-block-end: 1rem;
  }

  .tabbed-cards__tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: .5rem 3.5rem;
    margin-block-end: 1.5rem;
  }

  .tabbed-cards__tab {
    padding-block: .5rem;
    font-size: 1.125rem;
    letter-spacing: .03em;
    text-transform: uppercase;
    border-block-end: 1px solid transparent;
    opacity: .7;
    transition: opacity .2s, border-color .2s;
  }

  .tabbed-cards__tab[aria-selected="true"] {
    opacity: 1;
    border-color: currentColor;
  }

  .tabbed-cards__tab:hover {
    opacity: 1;
  }

  .tabbed-cards__panel {
    display: grid;
    grid: auto / auto-flow 70vw;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .tabbed-cards__panel[hidden] {
    display: none;
  }

  .tabbed-cards__card {
    display: grid;
    gap: 1rem;
    justify-items: center;
    scroll-snap-align: start;
  }

  .tabbed-cards__media {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .tabbed-cards__media img,
  .tabbed-cards__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tabbed-cards__label {
    font-size: .8125rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-align: center;
  }

  @media screen and (min-width: 700px) {
    .tabbed-cards__panel {
      grid: auto / repeat(var(--tabbed-cards-columns), minmax(0, 1fr));
      overflow: visible;
    }

    .tabbed-cards__tab {
      font-size: 1.5rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!window.customElements.get('tabbed-collection-cards')) {
    class TabbedCollectionCards extends HTMLElement {
      connectedCallback() {
        this.tabs = Array.from(this.querySelectorAll('[role="tab"]'));
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => this.select(tab));
          tab.addEventListener('keydown', (event) => this.onKeyDown(event, tab));
        });

        // In the theme editor, reveal the tab whose block (or card) is being edited
        this.addEventListener('shopify:block:select', (event) => {
          const panel = event.target.closest('[role="tabpanel"]');
          const tab = event.target.closest('[role="tab"]') || (panel && this.querySelector(`[aria-controls="${panel.id}"]`));
          if (tab) this.select(tab);
        });
      }

      select(selectedTab) {
        this.tabs.forEach((tab) => {
          const isSelected = tab === selectedTab;
          tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          tab.tabIndex = isSelected ? 0 : -1;
          document.getElementById(tab.getAttribute('aria-controls')).hidden = !isSelected;
        });
      }

      onKeyDown(event, tab) {
        const index = this.tabs.indexOf(tab);
        const targets = {
          ArrowRight: (index + 1) % this.tabs.length,
          ArrowLeft: (index - 1 + this.tabs.length) % this.tabs.length,
          Home: 0,
          End: this.tabs.length - 1
        };
        if (!(event.key in targets)) return;
        event.preventDefault();
        const next = this.tabs[targets[event.key]];
        this.select(next);
        next.focus();
      }
    }

    window.customElements.define('tabbed-collection-cards', TabbedCollectionCards);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Tabbed collection cards",
  "class": "shopify-section--tabbed-collection-cards",
  "tag": "section",
  "max_blocks": 30,
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Our Favorites"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "t:global.text.heading_style",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "cards_per_row",
      "label": "Cards per row (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "paragraph",
          "content": "Cards placed below this tab are shown when it is selected."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Tab title",
          "default": "Now trending"
        }
      ]
    },
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Used as the default image, label and link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Portrait image, 3:4 ratio recommended"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed collection cards",
      "blocks": [
        { "type": "tab", "settings": { "title": "Now trending" } },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "tab", "settings": { "title": "New arrivals" } },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
