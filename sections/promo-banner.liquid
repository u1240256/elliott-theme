{%- comment -%}
  Full-width clickable promotional image (e.g. "Buy one, get one 50% off"). Supports a separate mobile image.
{%- endcomment -%}
{%- if section.settings.image != blank -%}
  <div class="promo-banner {% unless section.settings.remove_vertical_spacing %}section-spacing{% endunless %}">
    <div class="{% if section.settings.full_width %}promo-banner__inner--full{% else %}container container--lg{% endif %}">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="promo-banner__link" aria-label="{{ section.settings.accessibility_label | default: section.settings.image.alt | escape }}">
      {%- endif -%}

      {%- if section.settings.mobile_image != blank -%}
        {{- section.settings.mobile_image | image_url: width: 1200 | image_tag: sizes: '100vw', widths: '400,600,800,1000,1200', class: 'promo-banner__image sm:hidden', loading: 'lazy' -}}
        {{- section.settings.image | image_url: width: 3000 | image_tag: sizes: '100vw', widths: '800,1000,1200,1400,1600,1800,2000,2400,3000', class: 'promo-banner__image hidden sm:block', loading: 'lazy' -}}
      {%- else -%}
        {{- section.settings.image | image_url: width: 3000 | image_tag: sizes: '100vw', widths: '400,600,800,1000,1200,1400,1600,1800,2000,2400,3000', class: 'promo-banner__image', loading: 'lazy' -}}
      {%- endif -%}

      {%- if section.settings.link != blank -%}
        </a>
      {%- endif -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="promo-banner section-spacing">
    <div class="container container--lg">
      {{- 'hero-apparel-1' | placeholder_svg_tag: 'promo-banner__placeholder' -}}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .promo-banner__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .promo-banner__link {
    display: block;
  }

  .promo-banner__placeholder {
    width: 100%;
    height: 160px;
    background: rgb(var(--text-color) / .05);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo banner",
  "class": "shopify-section--promo-banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Wide banner, e.g. 3000 x 260px"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. Shown on screens below 700px."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessible label",
      "info": "Describes the banner for screen readers, e.g. \"Buy one, get one 50% off all pajamas\""
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "remove_vertical_spacing",
      "label": "Remove vertical spacing",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Promo banner"
    }
  ]
}
{% endschema %}
