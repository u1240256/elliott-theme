{%- comment -%}
  Scrolling strip of products from a collection: thumbnail, title and a short status line.
  Per-product overrides (optional product metafields):
  - custom.ticker_label (single line text), e.g. "Hot right now". Falls back to the section's default label.
  - custom.units_sold (integer). Only shown when set, so no number is ever invented.
{%- endcomment -%}
{%- assign products = section.settings.collection.products -%}

{%- comment -%}"Mix it up": see snippets/varied-products.{%- endcomment -%}
{%- if section.settings.vary_products -%}
  {%- capture picked -%}{%- render 'varied-products', products: products, count: section.settings.products_count -%}{%- endcapture -%}
{%- endif -%}
{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

<div class="product-ticker color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
  {%- if section.settings.title != blank -%}
    <p class="product-ticker__title">
      <span class="product-ticker__pulse" aria-hidden="true"></span>
      {{ section.settings.title }}
    </p>
  {%- endif -%}

  {%- assign marquee_id = 'product-ticker-marquee-' | append: section.id -%}
  {%- render 'marquee-pause-button', target: marquee_id, class: 'product-ticker__toggle' -%}

  <marquee-text id="{{ marquee_id }}" speed="{{ section.settings.scrolling_speed }}" direction="left" pause-on-hover class="scrolling-content">
    <div class="scrolling-content__item">
      {%- if section.settings.collection != blank -%}
        {%- liquid
          if section.settings.vary_products
            assign loop_limit = 50
          else
            assign loop_limit = section.settings.products_count
          endif
        -%}
        {%- for product in products limit: loop_limit -%}
          {%- if section.settings.vary_products -%}
            {%- assign picked_key = ',' | append: product.handle | append: ',' -%}
            {%- unless picked contains picked_key -%}{%- continue -%}{%- endunless -%}
          {%- endif -%}
          {%- assign ticker_label = product.metafields.custom.ticker_label.value | default: section.settings.default_label -%}
          {%- assign units_sold = product.metafields.custom.units_sold.value -%}

          <a href="{{ product.url }}" class="product-ticker__item">
            {%- if product.featured_media -%}
              {{- product.featured_media | image_url: width: 100 | image_tag: width: 50, height: 50, sizes: '50px', widths: '50,100', class: 'product-ticker__image', loading: 'lazy', alt: '' -}}
            {%- endif -%}

            <span class="product-ticker__info">
              <span class="product-ticker__name">{{ product.title }}</span>
              <span class="product-ticker__status">
                {%- if section.settings.icon != blank %}<span aria-hidden="true">{{ section.settings.icon }}</span> {% endif -%}
                {{ ticker_label }}
                {%- if units_sold != blank and units_sold > 0 %} {{ units_sold }} sold{% endif -%}
              </span>
            </span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          <span class="product-ticker__item">
            {{- 'product-1' | placeholder_svg_tag: 'product-ticker__image' -}}
            <span class="product-ticker__info">
              <span class="product-ticker__name">Product title</span>
              <span class="product-ticker__status">{{ section.settings.default_label }}</span>
            </span>
          </span>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </marquee-text>
</div>

{% stylesheet %}
  /* A Gold Deep tag sits beside (desktop) or above (mobile) a strip of cream pill chips */
  .product-ticker {
    --scrolling-content-content-gap: .75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .75rem 1rem;
    padding: 1.25rem var(--container-gutter);
  }

  .product-ticker__title {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    margin-inline-end: auto;
    padding: .5rem 1rem;
    font-size: .6875rem;
    font-weight: 500;
    letter-spacing: .16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #ffffff;
    background: #916323;
    border-radius: 999px;
  }

  .product-ticker__pulse {
    position: relative;
    width: .375rem;
    height: .375rem;
    background: currentColor;
    border-radius: 50%;
  }

  .product-ticker__pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: currentColor;
    animation: product-ticker-pulse 1.8s ease-out infinite;
  }

  @keyframes product-ticker-pulse {
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-ticker__pulse::after {
      animation: none;
    }
  }

  .product-ticker .scrolling-content {
    order: 1;
    flex: 1 0 100%;
    min-width: 0;
    mask-image: linear-gradient(to right, transparent, #000 2.5rem, #000 calc(100% - 2.5rem), transparent);
  }

  .product-ticker__item {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .3125rem 1.25rem .3125rem .3125rem;
    background: #f7f0e8;
    border-radius: 999px;
  }

  .product-ticker__image {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: cover;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .product-ticker__info {
    display: grid;
    gap: .125rem;
    white-space: nowrap;
  }

  .product-ticker__name {
    max-width: 13rem;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--heading-font-family);
    font-size: 1.0625rem;
    line-height: 1.2;
  }

  .product-ticker__status {
    font-size: .625rem;
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #916323;
  }

  @media screen and (min-width: 700px) {
    .product-ticker {
      flex-wrap: nowrap;
      gap: 1.25rem;
    }

    .product-ticker__title {
      margin-inline-end: 0;
    }

    .product-ticker__toggle {
      order: 1;
    }

    .product-ticker .scrolling-content {
      order: 0;
      flex: 1 1 auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product ticker",
  "class": "shopify-section--product-ticker",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Selling fast"
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Icon (emoji)",
      "info": "Shown before each product's status line. Leave empty for none.",
      "default": ""
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products to show",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "vary_products",
      "label": "Mix it up",
      "info": "Prefer one product per product type and per color",
      "default": true
    },
    {
      "type": "text",
      "id": "default_label",
      "label": "Default status label",
      "info": "Override per product with the metafield custom.ticker_label. Add custom.units_sold (integer) to show a real sold count.",
      "default": "Selling fast"
    },
    {
      "type": "range",
      "id": "scrolling_speed",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "label": "t:sections.scrolling_content.scrolling_speed",
      "default": 0.2
    }
  ],
  "presets": [
    {
      "name": "Product ticker"
    }
  ]
}
{% endschema %}
