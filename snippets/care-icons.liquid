{%- comment -%}
  Brand-kit care icons (Ink line icons on Cream circles) with live Montserrat labels. Used in the product "Fabric & care" accordion.
{%- endcomment -%}
<ul class="care-icons" role="list">
  <li class="care-icons__item">
    <img src="{{ 'care-wash-cold.svg' | asset_url }}" alt="" width="44" height="44" loading="lazy">
    <span>Wash cold</span>
  </li>
  <li class="care-icons__item">
    <img src="{{ 'care-gentle-cycle.svg' | asset_url }}" alt="" width="44" height="44" loading="lazy">
    <span>Gentle cycle</span>
  </li>
  <li class="care-icons__item">
    <img src="{{ 'care-tumble-dry-low.svg' | asset_url }}" alt="" width="44" height="44" loading="lazy">
    <span>Tumble dry low</span>
  </li>
  <li class="care-icons__item">
    <img src="{{ 'care-do-not-bleach.svg' | asset_url }}" alt="" width="44" height="44" loading="lazy">
    <span>Do not bleach</span>
  </li>
</ul>
